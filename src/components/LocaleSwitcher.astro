---
/**
 * Language switcher. Zero JS: a labelled <nav> landmark holding a list of links, one per locale.
 *
 * - Each locale is its own URL, so the others are links (not buttons, a select, or radios).
 * - The current locale is plain text with aria-current, so it is announced but adds no tab stop.
 * - Visible text is the abbreviation (aria-hidden, with an <abbr title> for WCAG 3.1.4); the
 *   accessible name is the language's own name in a visually hidden span, read in that language.
 * - State is shown by underline (links) vs semibold (current), never by color alone.
 * - Targets are at least 44×44px (2.5.5); every state keeps text contrast ≥ 7:1 (1.4.6).
 * - translate="no" keeps page translation from rewriting language names.
 */
import { localeOf, localePath, locales } from '../lib/sanity/locale';

const current = localeOf(Astro.currentLocale);
---

<nav class="locale-switcher" aria-label={current.navLabel} translate="no">
  <ul class="locale-switcher__list">
    {locales.map((l) => (
      <li>
        {l.id === current.id ? (
          <span class="locale-switcher__item" lang={l.hreflang} aria-current="true">
            <abbr class="locale-switcher__abbr" title={l.name} aria-hidden="true">
              {l.label}
            </abbr>
            <span class="sr-only">{l.name}</span>
          </span>
        ) : (
          <a class="locale-switcher__item" href={localePath(l.id)} lang={l.hreflang} hreflang={l.hreflang}>
            <abbr class="locale-switcher__abbr" title={l.name} aria-hidden="true">
              {l.label}
            </abbr>
            <span class="sr-only">{l.name}</span>
          </a>
        )}
      </li>
    ))}
  </ul>
</nav>

<script>
  // Enhancement only: keep the current section when switching (anchors are shared across locales).
  document.querySelectorAll<HTMLAnchorElement>('.locale-switcher a').forEach((a) =>
    a.addEventListener('click', () => {
      if (location.hash) a.hash = location.hash;
    })
  );
</script>

<style>
  .locale-switcher {
    --locale-current: var(--color-dark); /* 14.91:1 on cream */
    --locale-muted: color-mix(in srgb, var(--color-dark) 80%, var(--color-cream)); /* 8.33:1 on cream */
  }

  .locale-switcher__list {
    display: flex;
    align-items: center;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .locale-switcher__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding-inline: 0.375rem;
    border-radius: 2px;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--locale-current);
  }

  .locale-switcher__abbr {
    text-decoration: none; /* reset the UA dotted underline on abbr[title] */
    cursor: inherit;
  }

  a.locale-switcher__item {
    font-weight: 400;
    color: var(--locale-muted);
  }

  /* Underline lives on the abbr: decoration doesn't reliably propagate into flex items. */
  a.locale-switcher__item .locale-switcher__abbr {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  a.locale-switcher__item:is(:hover, :focus-visible) {
    color: var(--locale-current);
  }

  a.locale-switcher__item:is(:hover, :focus-visible) .locale-switcher__abbr {
    text-decoration-thickness: 2px;
  }

  a.locale-switcher__item:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .locale-switcher__abbr {
      transition: text-decoration-thickness 120ms ease-out;
    }
  }
</style>
