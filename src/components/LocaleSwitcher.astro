---
/**
 * Language switcher. Zero JS: a labelled <nav> landmark holding a list of links, one per locale.
 *
 * - Each locale is its own URL, so the others are links (not buttons, a select, or radios).
 * - The current locale is plain text with aria-current, so it is announced but adds no tab stop.
 * - Visible text is the abbreviation (aria-hidden, with an <abbr title> for WCAG 3.1.4); the
 *   accessible name is the language's own name in a visually hidden span, read in that language.
 * - State is shown by weight and a tinted pill (current is semibold on it), never by color alone.
 * - Links use the shared press-ring, like the nav links, so hover, press, and keyboard focus (a
 *   4.6:1 ring in place of the browser outline) look and time the same across the header.
 * - Targets are at least 44×44px (2.5.5); every state keeps text contrast ≥ 7:1 (1.4.6).
 * - translate="no" keeps page translation from rewriting language names.
 */
import { localeOf, localePath, locales, messagesOf } from '../lib/sanity/locale';

const current = localeOf(Astro.currentLocale);
---

<nav class="locale-switcher" aria-label={messagesOf(Astro.currentLocale).switcherLabel} translate="no">
  <ul class="locale-switcher__list">
    {locales.map((l) => (
      <li>
        {l.id === current.id ? (
          <span class="locale-switcher__item" lang={l.hreflang} aria-current="true">
            <abbr class="locale-switcher__abbr" title={l.name} aria-hidden="true">
              {l.label}
            </abbr>
            <span class="sr-only">{l.name}</span>
          </span>
        ) : (
          <a class="locale-switcher__item press-ring" href={localePath(l.id)} lang={l.hreflang} hreflang={l.hreflang}>
            <abbr class="locale-switcher__abbr" title={l.name} aria-hidden="true">
              {l.label}
            </abbr>
            <span class="sr-only">{l.name}</span>
          </a>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  .locale-switcher {
    --locale-spacing: 0.04em;
    --locale-pill: color-mix(in srgb, var(--color-dark) 6%, var(--color-cream)); /* text on it: 13.2:1 */
  }

  .locale-switcher__list {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .locale-switcher__list li {
    display: flex;
    align-items: center;
  }

  .locale-switcher__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding-inline: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 650;
    line-height: 1;
    letter-spacing: var(--locale-spacing);
    text-transform: uppercase;
    text-decoration: none;
  }

  span.locale-switcher__item {
    position: relative;
    isolation: isolate;
  }

  span.locale-switcher__item::before {
    content: '';
    position: absolute;
    inset: 0.5rem 0.125rem;
    z-index: -1;
    border: 1px solid transparent; /* the pill's edge in forced colors, which drop backgrounds */
    border-radius: 9999px;
    background: var(--locale-pill);
  }

  .locale-switcher__abbr {
    margin-inline-end: calc(var(--locale-spacing) * -1);
    text-decoration: none;
    cursor: inherit;
  }

  a.locale-switcher__item {
    font-weight: 450;
  }
</style>
