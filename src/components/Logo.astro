---
/**
 * The shell (Shell.astro) as the logo mark, filled with the link's text color. It lifts slightly on
 * hover or focus and settles back on press. Timing comes from the parent's --ring-* properties, so
 * it moves in step with the ring: put it inside a `group press-ring` link.
 */
import type { HTMLAttributes } from 'astro/types';
import Shell from './Shell.astro';

type Props = HTMLAttributes<'span'>;

const { class: className, ...props } = Astro.props;
---

<span class:list={['logo', className]} aria-hidden="true" {...props}>
  <Shell class="logo__mark" />
</span>

<style>
  .logo {
    display: inline-block;
  }

  .logo__mark {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    scale: 1;
    --logo-lift: 1.07;
    transition: scale var(--ring-duration) var(--ring-ease);
  }

  :global(.group:focus-visible) .logo__mark {
    scale: var(--logo-lift);
  }

  @media (hover: hover) {
    :global(.group:hover) .logo__mark {
      scale: var(--logo-lift);
    }
  }

  :global(.group:active) .logo__mark {
    scale: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo__mark {
      transition: none;
    }
  }
</style>
