---
import type { HomeContent } from '../lib/sanity/getHomeContent';
import { imageUrlBuilder } from '../lib/sanity/image';

interface Props {
  approach: NonNullable<HomeContent['approach']>;
}

const { heading, intro, pillars, image, imageAlt } = Astro.props.approach;
const imageUrl = image?.asset && imageUrlBuilder.image(image).width(1200).auto('format').url();
---

<section id="enfoque" class="bg-cream py-24 px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
    <div>
      <h2 class="text-5xl md:text-6xl font-black text-dark mb-8 leading-tight">{heading}</h2>
      <p class="text-xl font-semibold text-dark leading-snug mb-12">{intro}</p>
      <div class="space-y-8">
        {(pillars ?? []).map((pillar) => (
          <div>
            <h3 class="text-base font-bold text-dark mb-2">{pillar.title}</h3>
            <p class="text-sm text-dark/80 leading-relaxed">{pillar.body}</p>
          </div>
        ))}
      </div>
    </div>
    {imageUrl && (
      <div class="rounded-2xl overflow-hidden">
        <img src={imageUrl} alt={imageAlt ?? ''} class="w-full h-full object-cover grayscale" loading="lazy" />
      </div>
    )}
  </div>
</section>
