---
import type { HomeContent } from '../lib/sanity/getHomeContent';

interface Props {
  contact: NonNullable<HomeContent['contact']>;
  footer: NonNullable<HomeContent['footer']>;
}

const { email, phone } = Astro.props.contact;
const { copyright } = Astro.props.footer;
const year = new Date().getFullYear();
---

<footer class="bg-cream py-8 px-6 text-center text-xs text-dark/50 space-y-2">
  <p>
    {email} | {phone}
  </p>
  <p>
    © {year} {copyright}
  </p>
</footer>
