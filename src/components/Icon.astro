---
/** Small stroke icons (24px grid, drawn in the current text color), decorative: the control that
 *  holds one carries the accessible name. */
import type { HTMLAttributes } from 'astro/types';

const paths = {
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
};

interface Props extends HTMLAttributes<'svg'> {
  name: keyof typeof paths;
}

const { name, ...props } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  {...props}
>
  <path d={paths[name]}></path>
</svg>
