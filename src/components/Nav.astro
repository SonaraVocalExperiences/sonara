---
import type { HomeContent } from '../lib/sanity/getHomeContent';
import { localePath, siteLocale } from '../lib/sanity/locale';
import Logo from './Logo.astro';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props {
  nav: NonNullable<HomeContent['nav']>;
}

const { approachLabel, contactLabel } = Astro.props.nav;
const home = localePath(siteLocale(Astro.currentLocale));
const links = [
  { href: '#enfoque', label: approachLabel },
  { href: '#contacto', label: contactLabel },
];
---

<header class="sticky top-0 z-50 h-(--header-height) px-6 bg-cream">
  <div class="mx-auto flex h-full max-w-6xl items-center gap-4">
    <a
      href={`${home}#top`}
      aria-current="page"
      class="group press-ring -mx-pill flex min-h-12 items-center gap-3 px-pill font-normal tracking-tight"
    >
      <Logo class="size-7" />
      <span>SONARA</span>
    </a>
    <nav class="flex items-center -space-x-1 text-sm font-medium">
      {links.map(({ href, label }) => (
        <a href={href} class="press-ring flex min-h-11 items-center px-pill">
          <span class="tracking-wide -me-(--tracking-wide)">{label}</span>
        </a>
      ))}
    </nav>
    <div class="ml-auto -me-3">
      <LocaleSwitcher />
    </div>
  </div>
</header>
