---
import type { HomeContent } from '../lib/sanity/getHomeContent';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props {
  nav: NonNullable<HomeContent['nav']>;
}

const { approachLabel, contactLabel } = Astro.props.nav;
---

<header class="fixed top-0 left-0 right-0 z-50 flex justify-between items-center gap-8 px-8 py-3 bg-cream">
  <nav class="flex items-center gap-8 text-sm font-medium tracking-wide">
    <a href="#enfoque" class="hover:opacity-70 transition-opacity">
      {approachLabel}
    </a>
    <a href="#contacto" class="hover:opacity-70 transition-opacity">
      {contactLabel}
    </a>
  </nav>
  <LocaleSwitcher />
</header>
