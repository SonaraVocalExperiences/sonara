---
import type { HomeContent } from '../lib/sanity/getHomeContent';
import { localePath, locales, siteLocale } from '../lib/sanity/locale';

interface Props {
  nav: NonNullable<HomeContent['nav']>;
}

const { approachLabel, contactLabel } = Astro.props.nav;
const current = siteLocale(Astro.currentLocale);
---

<nav class="fixed top-0 left-0 right-0 z-50 flex justify-end items-center gap-8 px-8 py-6 text-sm font-medium tracking-wide">
  <a href="#enfoque" class="hover:opacity-70 transition-opacity">
    {approachLabel}
  </a>
  <a href="#contacto" class="hover:opacity-70 transition-opacity">
    {contactLabel}
  </a>
  {locales
    .filter((l) => l.id !== current)
    .map((l) => (
      <a href={localePath(l.id)} class="hover:opacity-70 transition-opacity">
        {l.label}
      </a>
    ))}
</nav>
